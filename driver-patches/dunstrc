[global]
    monitor = 0
    follow = none
    width = 300
    height = 50
    origin = top-center
    offset = 10x50
    notification_limit = 1
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = yes
    transparency = 25
    padding = 8
    horizontal_padding = 8
    frame_width = 2
    frame_color = "#555555"
    sort = yes
    idle_threshold = 0
    font = 更纱黑体 SC 10
    markup = full
    format = "<b>%s</b>"
    alignment = center
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = no
    icon_position = off
    sticky_history = no
    history_length = 0
    corner_radius = 8
    ignore_dbusclose = false

[urgency_low]
    background = "#222222"
    foreground = "#888888"
    timeout = 1

[urgency_normal]
    background = "#285577"
    foreground = "#ffffff"
    timeout = 1

[urgency_critical]
    background = "#900000"
    foreground = "#ffffff"
    frame_color = "#ff0000"
    timeout = 1
